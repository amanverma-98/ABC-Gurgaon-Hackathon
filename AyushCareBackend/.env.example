PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ACCESS_TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRY=1d
DEFAULT_HOSPITAL_ID=YOUR_HOSPITAL_UUID
KIOSK_SESSION_TTL_MINUTES=30
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=YOUR_BUCKET
MEDIKIOSK_AI_BASE_URL=http://127.0.0.1:8001
MEDIKIOSK_AI_FALLBACK_URL=
MEDIKIOSK_AI_TIMEOUT_MS=20000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SMS_PROVIDER=mock

# P2Care Emergency Features
P2CARE_MAX_ACCESS_GRANT_HOURS=36
P2CARE_DEFAULT_ACCESS_GRANT_HOURS=8

# AI provider credentials (Bhashini/Azure/Groq) belong ONLY in the Python ML service environment.
