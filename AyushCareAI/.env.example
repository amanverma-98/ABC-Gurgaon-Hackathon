ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

#Bhashini API (Government AI Platform)
BHASHINI_UDYAT_KEY=
BHASHINI_USER_ID=medikiosk
BHASHINI_INFERENCE_KEY=

# OCR & Document Intelligence
OCR_PROVIDER=azure
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# TESSERACT_CMD=/usr/bin/tesseract  # Optional local fallback

# Medical NLP
MEDICAL_NLP_PROVIDER=azure
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_API_VERSION=2023-04-01

#ASR — Speech-to-Text
ASR_PROVIDER=bhashini
WHISPER_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=bhashini
TRANSLATION_PROVIDER=bhashini
LANGUAGE_DETECTION_PROVIDER=bhashini
DATABASE_URL=sqlite+aiosqlite:///./medikiosk_dev.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=CHANGE_ME

# Docker Compose local database
POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
POSTGRES_DB=medikiosk
POSTGRES_PORT=5432
REDIS_PORT=6379
