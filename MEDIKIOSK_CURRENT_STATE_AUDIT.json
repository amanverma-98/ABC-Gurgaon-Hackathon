{
  "projects": {
    "python_ai": {
      "project_root": "AyushCareAI",
      "framework": "FastAPI",
      "runtime": "Python 3.10+",
      "language": "Python",
      "package_manager": "pip / poetry",
      "config_files": ["pyproject.toml", "requirements.txt", "Dockerfile", "docker-compose.yml"],
      "entry_point": "app/main.py",
      "source_directories": ["app/ai", "app/api", "app/domain", "app/infrastructure", "app/models", "app/services"],
      "database": "SQLite (dev: medikiosk_dev.db via SQLAlchemy async) / PostgreSQL (prod)",
      "redis": "redis://localhost:6379/0 (with in-memory fallback dict)"
    },
    "node_backend": {
      "project_root": "AyushCareBackend",
      "framework": "Express.js",
      "runtime": "Node.js (ES Modules)",
      "language": "JavaScript",
      "package_manager": "npm",
      "config_files": ["package.json", "package-lock.json"],
      "entry_point": "src/index.js (server) / src/app.js (express)",
      "source_directories": ["src/controllers", "src/database", "src/middleware", "src/routes", "src/services", "src/utilities"],
      "database": "PostgreSQL (Neon Serverless via pg.Pool)",
      "redis": "None (uses in-memory Map for OTPs)"
    },
    "kiosk": {
      "project_root": "AyushCareKiosk",
      "framework": "React 18 + Vite",
      "runtime": "Browser / Chromium Kiosk",
      "language": "JavaScript (JSX)",
      "package_manager": "npm",
      "config_files": ["package.json", "vite.config.js", "eslint.config.js"],
      "entry_point": "src/main.jsx",
      "source_directories": ["src/pages", "src/components", "src/services", "src/store", "src/constants", "src/loc"]
