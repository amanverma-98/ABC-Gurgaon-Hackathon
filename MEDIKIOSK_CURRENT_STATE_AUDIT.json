  "database": {
    "engine_backend": "PostgreSQL (Neon)",
    "engine_ai": "SQLite (development: medikiosk_dev.db) / PostgreSQL",
    "backend_tables": [
      {
        "table": "hospitals",
        "pk": "id (UUID)",
        "columns": ["id", "name", "state_code", "created_at"],
        "foreign_keys": []
      },
      {
        "table": "users",
        "pk": "id (UUID)",
        "columns": ["id", "hospital_id", "name", "email", "password_hash", "role", "specialization", "is_active", "created_at"],
        "foreign_keys": ["hospital_id -> hospitals.id"]
      },
      {
        "table": "patients",
        "pk": "id (UUID)",
        "columns": ["id", "abha_number", "abha_address", "full_name", "gender", "date_of_birth", "mobile_number", "address", "aadhaar_number", "registration_type", "consent_granted", "consent_timestamp", "created_at"],
        "foreign_keys": [],
        "unique_constraints": ["abha_number", "abha_address"],
        "indexes": ["idx_patients_mobile", "idx_patients_aadhaar", "idx_patients_abha_number"]
      },
      {
        "table": "departments",
        "pk": "id (UUID)",
        "columns": ["id", "hospital_id", "name", "pathway", "is_active", "created_at"],
        "foreign_keys": ["hospital_id -> hospitals.id"],
        "unique_constraints": ["(hospital_id, name)"]
      },
      {
        "table": "doctor_departments",
        "pk": "(doctor_id, department_id)",
        "columns": ["doctor_id", "department_id", "created_at"],
        "foreign_keys": ["doctor_id -> users.id", "department_id -> departments.id"]
      },
      {
        "table": "consultations",
        "pk": "id (UUID)",
        "columns": ["id", "hospital_id", "patient_id", "department_id", "assigned_doctor_id", "token_number", "status", "risk_level", "intake_pathway", "language", "ai_session_id", "remarks", "created_at", "updated_at"],
        "foreign_keys": ["hospital_id -> hospitals.id", "patient_id -> patients.id", "department_id -> departments.id", "assigned_doctor_id -> users.id"]
      },
      {
        "table": "clinical_summaries",
        "pk": "id (UUID)",
        "columns": ["id", "consultation_id", "chief_complaint", "history_of_present_illness", "past_medical_history", "drug_allergies", "medications", "ayush_attributes", "ai_payload", "generated_at", "updated_at"],
        "foreign_keys": ["consultation_id -> consultations.id (UNIQUE)"]
      },
      {
        "table": "uploaded_documents",
        "pk": "id (UUID)",
        "columns": ["id", "consultation_id", "file_path_hash", "document_type", "source_mime_type", "page_number", "total_pages", "extracted_data", "status", "processing_error", "created_at", "updated_at"],
        "foreign_keys": ["consultation_id -> consultations.id"]
      },
      {
        "table": "kiosk_sessions",
        "pk": "id (UUID)",
        "columns": ["id", "pairing_token", "kiosk_id", "consultation_id", "is_active", "expires_at", "created_at"],
        "foreign_keys": ["consultation_id -> consultations.id"],
        "unique_constraints": ["pairing_token"]
      },
      {
        "table": "patient_qr_tokens",
        "pk": "id (UUID)",
        "columns": ["id", "token_hash", "patient_id", "consultation_id", "expires_at", "used_at", "created_at"],
        "foreign_keys": ["patient_id -> patients.id", "consultation_id -> consultations.id"],
        "unique_constraints": ["token_hash"]
      },
      {
        "table": "vitals",
        "pk": "id (UUID)",
        "columns": ["id", "consultation_id", "systolic", "diastolic", "pulse", "temperature", "spo2", "source", "recorded_at"],
        "foreign_keys": ["consultation_id -> consultations.id (UNIQUE)"]
      },
      {
        "table": "consent_records",
        "pk": "id (UUID)",
        "columns": ["id", "consultation_id", "scope_id", "title", "purpose", "required", "status", "granted_at", "withdrawn_at"],
        "foreign_keys": ["consultation_id -> consultations.id"]
      },
      {
        "table": "patient_privacy_rules",
        "pk": "id (UUID)",
        "columns": ["id", "patient_id", "scope_type", "hospital_id", "consultation_id", "document_id", "allow_doctor_access", "reason", "created_at", "updated_at"],
        "foreign_keys": ["patient_id -> patients.id", "hospital_id -> hospitals.id", "consultation_id -> consultations.id", "document_id -> uploaded_documents.id"]
      },
      {
        "table": "privacy_settings",
        "pk": "id (UUID)",
        "columns": ["id", "patient_id", "isolate_past_history", "consent_voice_processing", "share_previous_departments", "share_previous_reports", "share_previous_appointments", "lock_diagnosis", "lock_visits", "lock_reports", "updated_at"],
        "foreign_keys": ["patient_id -> patients.id (UNIQUE)"]
      },
      {
        "table": "audit_events",
        "pk": "id (BIGSERIAL)",
        "columns": ["id", "consultation_id", "actor_type", "actor_id", "event_type", "metadata", "created_at"],
        "foreign_keys": ["consultation_id -> consultations.id"]
      }
    ],
    "ai_sqlite_tables": [
      "sessions",
      "conversation_turns",
      "documents",
      "consent_receipts",
      "audit_log"
    ]
  },
